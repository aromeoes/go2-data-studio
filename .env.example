# Local robot configuration. Do not commit the filled-in .env file.
# Use the Go2 STA Wi-Fi IP shown in the Unitree app. Leave empty to enter it in the UI.
ROBOT_IP=
UNITREE_AES_128_KEY=

# Launcher/runtime options are exported in the shell, not read from this file.
# See README.md: DIMOS_RUNTIME, GO2_SPACES, GO2_SERIAL and GO2_ENV_FILE.

# HumanCLI uses the DimOS MCP agent with a configurable model provider.
# Copy to .env in this application folder. Existing process variables take precedence.
HUMANCLI_PROVIDER=openai
HUMANCLI_MODEL=gpt-4.1-mini
# Optional, for an OpenAI-compatible HTTPS endpoint or a local Ollama server:
# HUMANCLI_BASE_URL=http://127.0.0.1:11434
# Explicitly allow requested camera images to be sent to the selected provider:
HUMANCLI_VISION=false

# Set the key corresponding to your provider. Ollama does not require a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Select an installed tool-capable model when using HUMANCLI_PROVIDER=ollama.
# Model name should not include the provider prefix.
