{
  "name": "go2-data-studio-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone Go2 Data Studio desktop host",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package:mac": "electron-builder --mac dir --arm64",
    "package:linux": "electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.go2datastudio.desktop",
    "productName": "Go2 Data Studio",
    "files": ["*.cjs", "package.json"],
    "extraResources": [
      {"from": "../go2_setup", "to": "app/go2_setup", "filter": ["**/*", "!**/__pycache__/**"]},
      {"from": "../web/dist", "to": "app/web/dist"},
      {"from": "../vendor/dimos-web", "to": "app/vendor/dimos-web"}
    ],
    "mac": {"category": "public.app-category.utilities"},
    "linux": {"category": "Utility"}
  }
}
