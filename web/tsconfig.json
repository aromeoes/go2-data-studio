{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@dimos/sdk": [
        "../vendor/dimos-web/sdk/src/index.ts"
      ],
      "@dimos/sdk/internal/teleop": [
        "../vendor/dimos-web/sdk/src/internal/teleopMachine.ts"
      ],
      "@dimos/shared": [
        "../vendor/dimos-web/shared/protocol.ts"
      ],
      "@dimos/shared/manifest": [
        "../vendor/dimos-web/shared/manifest.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
